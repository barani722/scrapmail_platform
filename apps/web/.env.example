# Environment settings for the web app.
#
# Local development: copy this file to .env.local and fill in the values.
# Vercel: set the same keys in Project Settings > Environment Variables,
#         per environment (Production = prod database, Preview = staging).
#
# NEXT_PUBLIC_* values are embedded in the browser bundle.
# Never put a secret in a NEXT_PUBLIC_* variable.
# Never commit .env.local or any file containing real keys.

# Public base URL of the app (used for links, e.g. in auth emails).
# Optional on Vercel previews: falls back to the deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev server only: extra hosts allowed to open `next dev`, comma-separated.
# Example: this machine's public IP so other computers can view the dev server.
DEV_ALLOWED_ORIGINS=

# --- Supabase ---
# Dashboard > Project Settings > API Keys.
# Local: the dev project. Vercel Preview: staging. Vercel Production: prod.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret (bypasses RLS). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Sentry error monitoring (optional) ---
# Sentry > Project Settings > Client Keys (DSN). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
