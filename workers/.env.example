# Worker settings. Copy to workers/.env (never commit it).
# Same Supabase project as the web app: Dashboard > Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Web search for discovery (optional). Brave Search API key:
# https://api-dashboard.search.brave.com  > API Keys
BRAVE_API_KEY=
# Maximum Brave searches per calendar month (free credit covers ~1,000).
BRAVE_MONTHLY_LIMIT=950

# Optional
# WORKER_ID=server-1
# WORKER_CONCURRENCY=8
