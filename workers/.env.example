# Worker settings. Copy to workers/.env (never commit it).
# Same Supabase project as the web app: Dashboard > Project Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Web search for discovery (optional): Google results via Serper.
# https://serper.dev  > API Key (2,500 free searches on sign-up, no card)
SERPER_API_KEY=
# Maximum searches per calendar month (1 search = 1 credit).
SEARCH_MONTHLY_LIMIT=2400

# Optional
# WORKER_ID=server-1
# WORKER_CONCURRENCY=8
