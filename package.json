{
  "name": "scrapmail",
  "private": true,
  "description": "Scrap&Mail: agency discovery and database platform",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @scrapmail/web dev",
    "build": "pnpm --filter @scrapmail/web build",
    "start": "pnpm --filter @scrapmail/web start",
    "lint": "pnpm --filter @scrapmail/web lint",
    "typecheck": "pnpm --filter @scrapmail/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.122.0"
  }
}
